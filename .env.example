# DRIFT — environment
#
# Copy to `.env` and fill in. `.env` is gitignored and is never read by tooling
# in this repo other than the processes below.
#
#   cp .env.example .env
#
# Two different Sanity credentials are needed and they are NOT interchangeable.
# This is the single most common setup mistake, so it is worth stating plainly:
#
#   SANITY_WRITE_TOKEN   a PROJECT token. Writes documents to the Content Lake.
#   DRIFT_MCP_TOKEN      an ORGANISATION token. Reads the Knowledge Base over
#                        Context MCP. A project token is rejected outright.
#
# ---------------------------------------------------------------------------
# Sanity project — not secrets, these appear in the browser
# ---------------------------------------------------------------------------

# Dashboard > project > the id shown beside PROJECT ID
SANITY_STUDIO_PROJECT_ID=your_project_id_here
SANITY_STUDIO_DATASET=production

# The engine reads the same project under its own names, because it is a
# separate process that may run somewhere the Studio does not.
SANITY_PROJECT_ID=your_project_id_here
SANITY_DATASET=production

# The App SDK console reads these at build time (Vite only exposes VITE_*).
VITE_SANITY_PROJECT_ID=your_project_id_here
VITE_SANITY_DATASET=production

# ---------------------------------------------------------------------------
# Sanity credentials — secrets
# ---------------------------------------------------------------------------

# PROJECT token, Editor permission.
#   Dashboard > project > API > Tokens > Add API token
# Used by internal/contentlake to publish an approved correction and to write a
# standing instruction back. Without it the engine gates and audits approvals
# but refuses to claim a publication happened.
SANITY_WRITE_TOKEN=your_project_write_token_here

# The deployed schema Agent Actions bind to, from `sanity schema deploy`.
# List it with `sanity schema list`. Agent Actions are schema-aware — that is
# what stops a Transform writing a string into a number field — so this is
# required, not optional, for drafting.
SANITY_SCHEMA_ID=_.schemas.your_workspace_name

# ORGANISATION token with Context Viewer permission
# (grant `sanity.knowledge-base.read`).
#   Dashboard > organisation > Manage > API > Tokens
# Project-level tokens are rejected; the client says so in as many words.
DRIFT_MCP_TOKEN=your_organisation_context_viewer_token_here

# The Context MCP endpoint created in the Context app in the Dashboard.
#   https://api.sanity.io/v1/context/organizations/<orgId>/mcp/<endpointName>
DRIFT_MCP_ENDPOINT=https://api.sanity.io/v1/context/organizations/your_org_id/mcp/your_endpoint_name

# ---------------------------------------------------------------------------
# Engine identity
# ---------------------------------------------------------------------------

# Every grant and every audit entry is scoped to a tenant. Required in live mode.
DRIFT_TENANT=northwind

# The actor registry. NOT a Sanity credential — you invent these tokens.
#
# Semicolon-separated entries of `token:id:tenant:roles[:agent]`, where roles
# are PIPE-separated from viewer|agent|editor|steward|admin, and a fifth field
# of literally `agent` marks an unattended principal. The registry stores
# sha256 digests, never the tokens themselves.
#
#   DRIFT_ACTORS=tok_a:sam@northwind:northwind:steward;tok_b:bot:northwind:agent:agent
#
# Leave blank and run the engine with -fixtures to get the four demo principals
# against committed demo data.
DRIFT_ACTORS=

# ---------------------------------------------------------------------------
# Public site
# ---------------------------------------------------------------------------

# Where apps/web reads the drift ledger from, for its per-page integrity strip.
#
# DRIFT_ENGINE_TOKEN must be one of the tokens you put in DRIFT_ACTORS above —
# it is not a Sanity credential. A viewer-role actor is enough; the site only
# reads. Leave blank while the engine runs with -fixtures.
DRIFT_ENGINE_URL=http://127.0.0.1:8080
DRIFT_ENGINE_TOKEN=
