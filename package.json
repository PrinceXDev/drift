{
  "name": "drift",
  "private": true,
  "version": "0.1.0",
  "description": "A knowledge-integrity control plane built on Sanity Knowledge Bases.",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "engine:test": "cd services/drift-engine && go test ./...",
    "engine:run": "cd services/drift-engine && go run ./cmd/engine",
    "workflow:deploy": "sanity-workflows deploy"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "turbo": "2.11.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@sanity/blueprints": "0.26.1",
    "@sanity/functions": "1.8.0",
    "@sanity/workflow-cli": "0.33.0",
    "@sanity/workflow-engine": "0.33.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0"
    }
  }
}
